{
  // Type checking only (`pnpm typecheck`). Node 24 runs the .ts files directly by stripping types,
  // so the code sticks to erasable syntax (no enums, no namespaces) and imports with .ts extensions.
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": ["packages", "agents", "apps"],
  "exclude": ["**/node_modules", "**/dist"]
}
